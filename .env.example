# PickleFlex environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values:
#   cp .env.example .env
# Never commit the real `.env` — it is gitignored.

# ---------------------------------------------------------------------------
# Database (required, server-only)
# ---------------------------------------------------------------------------
# Postgres connection string for the Supabase project. Read lazily by
# src/lib/db.ts on the first query, so `next build` works without it but
# every API route (auth, brackets) fails at runtime if it is missing.
#
# Find it in Supabase: Project Settings -> Database -> Connection string.
# Either form works (the client runs with `prepare: false`, so the
# transaction pooler is supported):
#   Direct connection:   postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
#   Transaction pooler:  postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
#
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
# Required tables: users, sessions, brackets, bracket_matches,
# participants, participant_members (created once via the Supabase SQL editor).
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Google OAuth web application credentials (server-only)
AUTH_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
